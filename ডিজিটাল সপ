<!DOCTYPE html>
<html lang="bn">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Sohoj Mart - সহজ মার্ট</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      background-color: #f4f4f4;
      margin: 0;
      padding-bottom: 70px;
    }
    .top-search-bar {
      background-color: #f85606;
      padding: 10px;
    }
    .search-input {
      width: 100%;
      padding: 10px 15px;
      font-size: 15px;
      border: none;
      border-radius: 4px;
      outline: none;
      box-sizing: border-box;
    }
    .page-content {
      display: none;
      padding: 10px;
    }
    .page-content.active {
      display: block;
    }
    .category-grid {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 8px;
      padding: 10px;
      background: #fff;
      margin-bottom: 10px;
      text-align: center;
    }
    .cat-item {
      cursor: pointer;
    }
    .cat-item img {
      width: 45px;
      height: 45px;
      border-radius: 50%;
      background: #eee;
      object-fit: cover;
    }
    .cat-item span {
      font-size: 11px;
      color: #333;
      display: block;
      margin-top: 4px;
    }
    .banner {
      width: 100%;
      height: 140px;
      background-image: url('https://img.freepik.com/free-vector/flat-design-sale-banner_23-2149318856.jpg');
      background-size: cover;
      background-position: center;
      margin-bottom: 10px;
    }
    .section-header {
      background: #fff;
      padding: 10px 15px;
      font-weight: bold;
      font-size: 15px;
      color: #f85606;
      border-bottom: 1px solid #eee;
    }
    .flash-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 10px;
      padding: 10px;
      background: #fff;
      margin-bottom: 10px;
    }
    .flash-card {
      background: #fff;
      border: 1px solid #eee;
      border-radius: 6px;
      padding: 10px;
      text-align: center;
    }
    .flash-card img {
      width: 100%;
      height: 110px;
      object-fit: cover;
      border-radius: 4px;
    }
    .p-title {
      font-size: 13px;
      color: #333;
      margin: 6px 0;
      font-weight: bold;
    }
    .p-price {
      color: #f85606;
      font-weight: bold;
      font-size: 14px;
      margin-bottom: 8px;
    }
    .order-btn {
      width: 100%;
      background: #f85606;
      color: white;
      border: none;
      padding: 8px;
      border-radius: 4px;
      font-size: 12px;
      cursor: pointer;
      font-weight: bold;
    }
    .admin-card {
      background: #fff;
      padding: 15px;
      border-radius: 8px;
      box-shadow: 0 2px 5px rgba(0,0,0,0.1);
      margin-bottom: 15px;
    }
    .admin-input {
      width: 100%;
      padding: 10px;
      margin-bottom: 10px;
      border: 1px solid #ddd;
      border-radius: 4px;
      box-sizing: border-box;
      font-size: 14px;
    }
    .add-product-btn {
      width: 100%;
      background: #28a745;
      color: white;
      border: none;
      padding: 10px;
      border-radius: 4px;
      font-weight: bold;
      font-size: 15px;
      cursor: pointer;
    }
    .cart-item-card {
      background: #fff;
      padding: 10px;
      margin-bottom: 8px;
      border-radius: 5px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .checkout-btn {
      width: 100%;
      background: #28a745;
      color: white;
      border: none;
      padding: 12px;
      border-radius: 5px;
      font-size: 16px;
      font-weight: bold;
      cursor: pointer;
      margin-top: 15px;
    }
    .bottom-nav {
      position: fixed;
      bottom: 0;
      left: 0;
      width: 100%;
      background: #fff;
      border-top: 1px solid #ddd;
      display: flex;
      justify-content: space-around;
      padding: 8px 0;
      z-index: 1000;
    }
    .nav-item {
      text-align: center;
      font-size: 11px;
      color: #666;
      text-decoration: none;
      cursor: pointer;
      flex-grow: 1;
    }
    .nav-item.active {
      color: #f85606;
      font-weight: bold;
    }
    .nav-item div {
      font-size: 18px;
    }
  </style>
</head>
<body>

  <!-- ১. সার্চ বার -->
  <div class="top-search-bar">
    <input type="text" id="searchInput" class="search-input" placeholder="🔍 সহজ মার্ট-এ পণ্য খুঁজুন..." onkeyup="searchProducts()">
  </div>

  <!-- হোম পেজ -->
  <div id="home-page" class="page-content active">
    <!-- ক্যাটাগরি আইকন -->
    <div class="category-grid">
      <div class="cat-item" onclick="filterCategory('ওয়াচ')">
        <img src="https://images.unsplash.com/photo-1523275335684-37898b6baf30" alt="">
        <span>ওয়াচ</span>
      </div>
      <div class="cat-item" onclick="filterCategory('হেডফোন')">
        <img src="https://images.unsplash.com/photo-1505740420928-5e560c06d30e" alt="">
        <span>হেডফোন</span>
      </div>
      <div class="cat-item" onclick="filterCategory('স্নিকার্স')">
        <img src="https://images.unsplash.com/photo-1542291026-7eec264c27ff" alt="">
        <span>জুতো</span>
      </div>
      <div class="cat-item" onclick="filterCategory('গেমিং')">
        <img src="https://images.unsplash.com/photo-1583394838336-acd977736f90" alt="">
        <span>গেমিং</span>
      </div>
      <div class="cat-item" onclick="filterCategory('সব')">
        <img src="https://images.unsplash.com/photo-1526170375885-4d8ecf77b99f" alt="">
        <span>সবগুলি</span>
      </div>
    </div>

    <!-- ব্যানার -->
    <div class="banner"></div>

    <!-- ফ্লাশ সেল প্রোডাক্টস -->
    <div class="section-header">⚡ আজকের ফ্লাশ সেল</div>
    <div class="flash-grid" id="productGrid">
      <!-- পণ্যগুলো এখানে আসবে -->
    </div>
  </div>

  <!-- ক্যাটাগরি পেজ -->
  <div id="category-page" class="page-content">
    <h2>📂 পণ্যের ক্যাটাগরি সমূহ</h2>
    <div style="background: white; padding: 15px; border-radius: 6px;">
      <p onclick="switchTab('home-page', document.getElementById('nav-home')); filterCategory('ওয়াচ')" style="cursor:pointer; padding:8px; border-bottom:1px solid #eee;">⌚ স্মার্ট ওয়াচ ও গ্যাজেট</p>
      <p onclick="switchTab('home-page', document.getElementById('nav-home')); filterCategory('হেডফোন')" style="cursor:pointer; padding:8px; border-bottom:1px solid #eee;">🎧 অডিও ও হেডফোন</p>
      <p onclick="switchTab('home-page', document.getElementById('nav-home')); filterCategory('স্নিকার্স')" style="cursor:pointer; padding:8px; border-bottom:1px solid #eee;">👟 ফ্যাশন ও জুতো</p>
      <p onclick="switchTab('home-page', document.getElementById('nav-home')); filterCategory('গেমিং')" style="cursor:pointer; padding:8px; border-bottom:1px solid #eee;">🎮 গেমিং এক্সেসরিজ</p>
    </div>
  </div>

  <!-- কার্ট পেজ -->
  <div id="cart-page" class="page-content">
    <h2>🛒 আপনার শপিং কার্ট</h2>
    <div id="cartItemsList">
      <p>আপনার কার্টটি বর্তমানে খালি!</p>
    </div>
    <div id="cartTotal" style="font-weight: bold; font-size: 16px; margin-top: 15px;"></div>
    <button class="checkout-btn" id="checkoutBtn" style="display:none;" onclick="sendWhatsAppOrder()">📲 হোয়াটসঅ্যাপে অর্ডার কনফার্ম করুন</button>
  </div>

  <!-- একাউন্ট ও নতুন পণ্য যোগ করার প্যানেল -->
  <div id="account-page" class="page-content">
    <div class="admin-card">
      <h2>🛠️ নতুন পণ্য যোগ করুন (অ্যাডমিন)</h2>
      <input type="text" id="newTitle" class="admin-input" placeholder="পণ্যের নাম দিন">
      <input type="number" id="newPrice" class="admin-input" placeholder="দাম লিখুন (টাকায়)">
      <input type="text" id="newImage" class="admin-input" placeholder="ছবির লিংক দিন">
      <input type="text" id="newCat" class="admin-input" placeholder="ক্যাটাগরি দিন">
      <button class="add-product-btn" onclick="addNewProduct()">পণ্য লাইভ করুন</button>
    </div>

    <div style="background: #fff; padding: 15px; border-radius: 8px; text-align: center;">
      <h3>👤 আমার একাউন্ট</h3>
      <p><b>নাম:</b> শামিম হোসেন</p>
      <p><b>মোবাইল:</b> ০১৮জ৭১৯৭৬৫৬</p>
      <p style="color: green; font-weight: bold;">স্ট্যাটাস: অ্যাডমিন ও বিক্রেতা</p>
    </div>
  </div>

  <!-- বটম নেভিগেশন বার -->
  <div class="bottom-nav">
    <div id="nav-home" class="nav-item active" onclick="switchTab('home-page', this)">
      <div>🏠</div>হোম
    </div>
    <div id="nav-cat" class="nav-item" onclick="switchTab('category-page', this)">
      <div>📂</div>ক্যাটাগরি
    </div>
    <div id="nav-cart" class="nav-item" onclick="switchTab('cart-page', this)">
      <div>🛒</div>কার্ট (<span id="cartCount">০</span>)
    </div>
    <div id="nav-acc" class="nav-item" onclick="switchTab('account-page', this)">
      <div>👤</div>একাউন্ট
    </div>
  </div>

  <script>
    const ownerPhone = "8801837197656";
    let cart = [];

    let products = [
      { title: "স্মার্ট ওয়াচ", price: 1250, image: "https://images.unsplash.com/photo-1523275335684-37898b6baf30", category: "ওয়াচ" },
      { title: "ওয়্যারলেস হেডফোন", price: 2100, image: "https://images.unsplash.com/photo-1505740420928-5e560c06d30e", category: "হেডফোন" },
      { title: "স্টাইলিশ স্নিকার্স", price: 1800, image: "https://images.unsplash.com/photo-1542291026-7eec264c27ff", category: "স্নিকার্স" },
      { title: "গেমিং কন্ট্রোলার", price: 1500, image: "https://images.unsplash.com/photo-1583394838336-acd977736f90", category: "গেমিং" }
    ];

    function renderProducts(list) {
      let grid = document.getElementById('productGrid');
      let html = "";
      for (let i = 0; i < list.length; i++) {
        html += `<div class="flash-card" data-cat="${list[i].category}">
                  <img src="${list[i].image}" alt="Image">
                  <div class="p-title">${list[i].title}</div>
                  <div class="p-price">৳ ${list[i].price}</div>
                  <button class="order-btn" onclick="addToCart('${list[i].title}', ${list[i].price})">কার্ডে যোগ করুন</button>
                 </div>`;
      }
      grid.innerHTML = html;
    }

    function addNewProduct() {
      let title = document.getElementById('newTitle').value;
      let price = Number(document.getElementById('newPrice').value);
      let image = document.getElementById('newImage').value;
      let category = document.getElementById('newCat').value;

      if(title === "" || price === "" || image === "" || category === "") {
        alert("দয়া করে সবগুলো ঘর পূরণ করুন!");
        return;
      }

      products.push({ title: title, price: price, image: image, category: category });
      renderProducts(products);
      alert("অভিনন্দন! নতুন পণ্য সফলভাবে যুক্ত হয়েছে।");
      
      document.getElementById('newTitle').value = "";
      document.getElementById('newPrice').value = "";
      document.getElementById('newImage').value = "";
      document.getElementById('newCat').value = "";
      
      switchTab('home-page', document.getElementById('nav-home'));
    }

    function switchTab(pageId, element) {
      let pages = document.getElementsByClassName('page-content');
      for (let p of pages) { p.classList.remove('active'); }
      document.getElementById(pageId).classList.add('active');

      if(element) {
        let navs = document.getElementsByClassName('nav-item');
        for (let n of navs) { n.classList.remove('active'); }
        element.classList.add('active');
      }
    }

    function addToCart(name, price) {
      cart.push({ name: name, price: price });
      document.getElementById('cartCount').innerText = cart.length;
      alert(`"${name}" কার্টে সফলভাবে যোগ করা হয়েছে!`);
      updateCartDisplay();
    }

    function updateCartDisplay() {
      let listDiv = document.getElementById('cartItemsList');
      let totalDiv = document.getElementById('cartTotal');
      let checkoutBtn = document.getElementById('checkoutBtn');

      if (cart.length === 0) {
        listDiv.innerHTML = "<p>আপনার কার্টটি বর্তমানে খালি!</p>";
        totalDiv.innerText = "";
        checkoutBtn.style.display = "none";
        return;
      }

      let html = "";
      let total = 0;
      for (let i = 0; i < cart.length; i++) {
        total += cart[i].price;
        html += `<div class="cart-item-card">
                  <span>${cart[i].name}</span>
                  <span style="color: #f85606; font-weight: bold;">৳ ${cart[i].price}</span>
                 </div>`;
      }
      listDiv.innerHTML = html;
      totalDiv.innerText = `মোট বিল: ৳ ${total}`;
      checkoutBtn.style.display = "block";
    }

    function sendWhatsAppOrder() {
      if (cart.length === 0) return;
      let message = "আসসালামু আলাইকুম, সহজ মার্ট থেকে নিচের পণ্যগুলো অর্ডার করতে চাই:\n\n";
      let total = 0;
      for (let i = 0; i < cart.length; i++) {
        message += (i + 1) + ". " + cart[i].name + " - ৳ " + cart[i].price + "\n";
        total += cart[i].price;
      }
      message += "\nমোট বিল: ৳ " + total;
      let url = "https://wa.me/88" + ownerPhone + "?text=" + encodeURIComponent(message);
      window.open(url, '_blank');
    }

    function filterCategory(catName) {
      let filtered = catName === 'সব' ? products : products.filter(p => p.category === catName);
      renderProducts(filtered);
    }

    function searchProducts() {
      let query = document.getElementById('searchInput').value.toLowerCase();
      let filtered = products.filter(p => p.title.toLowerCase().includes(query));
      renderProducts(filtered);
    }

    renderProducts(products);
  </script>

</body>
        </html>
